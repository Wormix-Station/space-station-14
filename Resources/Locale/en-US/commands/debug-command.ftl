cmd-showmarkers-desc = Toggles visibility of markers such as spawn points.
cmd-showmarkers-help = Usage: {$command}

# Wormix: the command toggles the whole subfloor or a single category.
cmd-showsubfloor-desc = Shows entities below the floor. Without an argument toggles every category, with one - wires, pipes or disposals.
cmd-showsubfloor-help = Usage: {$command} [wires|pipes|disposals|all]

cmd-notify-desc = Send a notify client side.
cmd-notify-help = Usage: {$command} <message>
