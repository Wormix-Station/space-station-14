<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
                      Title="{Loc 'playtime-grant-window-title'}"
                      MinSize="440 480"
                      SetSize="460 600">
    <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="6">
        <BoxContainer Orientation="Horizontal" SeparationOverride="6">
            <Label Text="{Loc 'playtime-grant-ckey-label'}" />
            <LineEdit Name="CkeyInput"
                      HorizontalExpand="True"
                      PlaceHolder="{Loc 'playtime-grant-ckey-placeholder'}" />
        </BoxContainer>

        <BoxContainer Orientation="Horizontal" SeparationOverride="6">
            <Label Text="{Loc 'playtime-grant-overall-label'}" HorizontalExpand="True" />
            <LineEdit Name="OverallInput" MinSize="100 0" PlaceHolder="0" />
        </BoxContainer>

        <BoxContainer Orientation="Horizontal" SeparationOverride="6">
            <CheckBox Name="GroupToggle"
                      Text="{Loc 'playtime-grant-group-label'}"
                      HorizontalExpand="True" />
            <LineEdit Name="GroupInput"
                      MinSize="100 0"
                      PlaceHolder="0"
                      Visible="False" />
        </BoxContainer>

        <Label Text="{Loc 'playtime-grant-jobs-label'}" />
        <LineEdit Name="SearchInput" PlaceHolder="{Loc 'playtime-grant-search'}" />

        <PanelContainer VerticalExpand="True">
            <PanelContainer.PanelOverride>
                <gfx:StyleBoxFlat BackgroundColor="#1B1B1E" />
            </PanelContainer.PanelOverride>
            <ScrollContainer VerticalExpand="True" HorizontalExpand="True" HScrollEnabled="False">
                <BoxContainer Name="JobList"
                              Orientation="Vertical"
                              SeparationOverride="2"
                              Margin="4" />
            </ScrollContainer>
        </PanelContainer>

        <Label Name="StatusLabel" Visible="False" />
        <BoxContainer Orientation="Horizontal" SeparationOverride="6">
            <Button Name="AddButton" Text="{Loc 'playtime-grant-add'}" HorizontalExpand="True" />
            <Button Name="SetButton" Text="{Loc 'playtime-grant-set'}" HorizontalExpand="True" />
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
